---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import site from '../data/site.json';
import { PREVIEW } from '../lib/media';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  overlayHeader?: boolean;
  projectNav?: { label: string; position: string } | null;
  floatingContact?: boolean;
}

const {
  title,
  description = site.seo.description,
  image,
  noindex = false,
  jsonLd = [],
  overlayHeader = false,
  projectNav = null,
  floatingContact = true,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : site.seo.title;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image ?? '/og-default.jpg', Astro.site).toString();

const person = {
  '@type': 'Person',
  '@id': new URL('/#personne', Astro.site).toString(),
  name: site.name,
  jobTitle: 'Responsable Communication',
  worksFor: { '@type': 'Organization', name: 'IGOA Moto' },
  knowsAbout: ['Communication digitale', 'Community management', 'Création de contenu', 'Photographie', 'Vidéo', 'Direction artistique'],
  knowsLanguage: ['fr', 'en'],
  address: { '@type': 'PostalAddress', addressRegion: 'Pays Basque', addressCountry: 'FR' },
  url: new URL('/', Astro.site).toString(),
  sameAs: [site.linkedin.url, site.instagram.url],
};
const graph = { '@context': 'https://schema.org', '@graph': [person, ...jsonLd] };
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || PREVIEW) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0b0b0c" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href="/fonts/archivo-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-motion');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    {PREVIEW && (
      <div class="preview-bar meta" role="note">Mode aperçu — les contenus marqués « Aperçu » ne sont pas publiés en production.</div>
    )}
    <Header overlay={overlayHeader} projectNav={projectNav} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {floatingContact && <a class="fab" href="/contact" data-fab>Contact</a>}
    <Lightbox />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

<style>
  main:focus { outline: none; }
  .preview-bar {
    position: fixed;
    left: 50%;
    bottom: 12px;
    z-index: 70;
    transform: translateX(-50%);
    padding: 6px 12px;
    background: var(--cognac-300);
    color: var(--noir-950);
    font-size: 10px;
    white-space: nowrap;
    pointer-events: none;
  }
  .fab {
    position: fixed;
    right: 20px;
    bottom: max(24px, env(safe-area-inset-bottom));
    z-index: 40;
    padding: 12px 18px;
    background: var(--blanc-50);
    color: var(--noir-950);
    font-size: 0.875rem;
    font-weight: 500;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition: opacity var(--dur-m) var(--ease-out), transform var(--dur-m) var(--ease-out);
  }
  .fab.is-on { opacity: 1; transform: none; pointer-events: auto; }
  @media (min-width: 768px) { .fab { display: none; } }
  @media (max-width: 767px) { .preview-bar { white-space: normal; width: calc(100vw - 24px); text-align: center; } }
</style>
