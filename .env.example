# Copie ce fichier en .env (en local) ou renseigne ces variables chez ton hébergeur.

# URL publique définitive du site (sitemap, canonical, Open Graph)
SITE_URL=https://www.ton-domaine.fr

# Formulaire de contact — envoi via l'API Brevo (https://www.brevo.com)
BREVO_API_KEY=
# Adresse qui reçoit les messages du formulaire (jamais affichée sur le site)
CONTACT_TO=
# Expéditeur technique, sur ton domaine vérifié dans Brevo (SPF / DKIM)
CONTACT_FROM=formulaire@ton-domaine.fr

# true = affiche aussi les contenus dont les droits ne sont pas encore accordés,
# avec un badge « Aperçu ». À n'utiliser QUE pour un aperçu privé, jamais en production.
PUBLIC_PREVIEW=false
