<dialog class="lb" data-lb aria-label="Visionneuse d'images">
  <div class="lb-top">
    <span class="meta lb-count" data-lb-count aria-live="polite"></span>
    <button class="lb-close meta" type="button" data-lb-close>Fermer ✕</button>
  </div>
  <figure class="lb-fig">
    <img data-lb-img alt="" />
    <figcaption class="meta lb-cap" data-lb-cap></figcaption>
  </figure>
  <button class="lb-nav lb-prev" type="button" data-lb-prev aria-label="Image précédente">←</button>
  <button class="lb-nav lb-next" type="button" data-lb-next aria-label="Image suivante">→</button>
</dialog>

<style>
  .lb {
    width: 100vw; height: 100dvh;
    max-width: none; max-height: none;
    margin: 0; padding: 0;
    border: 0;
    background: var(--noir-950);
    color: var(--blanc-50);
  }
  .lb::backdrop { background: var(--noir-950); }
  .lb[open] { display: grid; grid-template-rows: auto 1fr; }
  .lb-top { display: flex; justify-content: space-between; align-items: center; padding: 18px var(--margin); }
  .lb-close { color: var(--blanc-50); padding: 8px 0; }
  .lb-fig { display: grid; place-items: center; min-height: 0; padding: 0 var(--margin) 24px; gap: 12px; grid-template-rows: 1fr auto; }
  .lb-fig img { max-width: 100%; max-height: calc(100dvh - 140px); width: auto; height: auto; object-fit: contain; }
  .lb-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    padding: 18px;
    font-size: 1.5rem;
    color: var(--blanc-50);
  }
  .lb-nav:hover { color: var(--cognac-300); }
  .lb-prev { left: 4px; }
  .lb-next { right: 4px; }
  @media (max-width: 767px) { .lb-nav { display: none; } }
</style>
