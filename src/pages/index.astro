---
import Base from '../layouts/Base.astro';
import HeroMedia from '../components/HeroMedia.astro';
import Img from '../components/Img.astro';
import ContactSection from '../components/ContactSection.astro';
import site from '../data/site.json';
import { getProjets, preparer, disciplineLabel, href } from '../lib/projets';
import { resolveImage, publicFileExists, PREVIEW } from '../lib/media';

const projets = (await getProjets()).filter((p) => p.data.featured);
const prepared = projets.map((p) => ({ p, ...preparer(p) }));
const total = prepared.length;

const expertiseImages = site.expertises.map((e) => resolveImage(e.image));
const portrait = site.portrait ? resolveImage(site.portrait) : null;
const showHighlight = site.highlight.publishable || PREVIEW;
const methodeReady = site.methode.steps.every((s) => s.text);
const showMethode = methodeReady || PREVIEW;
const heroHasVideo = publicFileExists(site.hero.video) || publicFileExists(site.hero.videoMobile);
const cv = site.cv && publicFileExists(site.cv) ? `/${site.cv}` : null;

const jsonLd = [
  { '@type': 'WebSite', name: site.name, url: new URL('/', Astro.site).toString(), inLanguage: 'fr-FR' },
  {
    '@type': 'ProfilePage',
    url: new URL('/', Astro.site).toString(),
    mainEntity: { '@id': new URL('/#personne', Astro.site).toString() },
  },
];
---
<Base overlayHeader jsonLd={jsonLd}>
  <!-- 1. HERO -->
  <section class="hero" aria-labelledby="hero-titre" data-video-scope>
    <HeroMedia />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-content">
      <h1 class="display hero-name" id="hero-titre" data-reveal="lines">
        {site.nameLines.map((l) => <span class="line"><span>{l}</span></span>)}
        <span class="sr-only"> — {site.tagline}</span>
      </h1>
      <div class="hero-bottom grid">
        <p class="lead hero-tagline" aria-hidden="true">
          Communication digitale <span class="serif">&amp;</span> production visuelle — photo, vidéo, social media.
        </p>
        <p class="meta hero-meta">{site.specialty}<br />{site.currentRole}</p>
        <div class="hero-actions">
          <a class="meta hero-scroll" href="#projets">Défiler <span aria-hidden="true">↓</span></a>
          {heroHasVideo && <button class="meta hero-pause" type="button" data-video-toggle><span aria-hidden="true">❚❚</span> Pause</button>}
        </div>
      </div>
    </div>
  </section>

  <!-- 2. MANIFESTE -->
  <section class="light manifeste" aria-label="Manifeste">
    <div class="wrap grid">
      <span class="meta m-label">(00) Manifeste</span>
      <p class="h2 m-text" data-reveal>
        {site.manifesto.before} <span class="serif accent">{site.manifesto.accent}</span> {site.manifesto.after}
      </p>
    </div>
  </section>

  <!-- 3. PROJETS SÉLECTIONNÉS -->
  <section class="section projets" id="projets" aria-labelledby="projets-titre">
    <div class="wrap sec-head">
      <h2 class="display-l" id="projets-titre" data-reveal="lines">
        <span class="line"><span>Projets <span class="serif">sélectionnés</span></span></span>
      </h2>
      <span class="meta">(01) — {String(total).padStart(2, '0')} projets</span>
    </div>

    {prepared.map(({ p, cover, chapters }, i) => {
      const firstMedia = chapters.flatMap((c) => c.media);
      const n = String(i + 1).padStart(2, '0');
      const disc = p.data.disciplines.map(disciplineLabel).join(' · ') + (p.data.collection ? ' · Moto' : '');
      const year = p.data.year ?? '';
      const vt = `projet-${p.id}`;
      const caption = (
        <div class="wrap p-cap">
          <span class="num">{n}</span>
          <h3 class="p-title"><a href={href(p.id)} class="p-link">{p.data.title}</a></h3>
          <span class="meta p-disc">{disc}</span>
          <span class="meta p-role">{p.data.roleDisplayed ?? p.data.summary}</span>
          <span class="meta p-year">{year}</span>
        </div>
      );

      if (!cover) {
        return (
          <article class="p p--empty">
            <a class="wrap p-empty" href={href(p.id)} data-cursor="Voir">
              <span class="num">{n}</span>
              <span class="display-l">{p.data.title}</span>
              <span class="meta">{p.data.summary}</span>
            </a>
          </article>
        );
      }

      if (p.data.template === 'serie') {
        const trio = [cover, ...firstMedia.filter((m) => m.src !== cover.src)].slice(0, 3);
        return (
          <article class="p p--trio">
            <a class="wrap p-trio" href={href(p.id)} data-cursor="Voir" tabindex="-1" aria-hidden="true">
              {trio.map((m, k) => (
                <div class="media" data-reveal style={`--i:${k}`}>
                  <Img image={m.image} alt="" sizes="(max-width: 767px) 100vw, 33vw" vt={k === 0 ? vt : undefined} />
                </div>
              ))}
            </a>
            {caption}
          </article>
        );
      }

      if (p.data.template === 'video') {
        const four = firstMedia.slice(0, 4);
        return (
          <article class="p p--video">
            <a class="wrap p-four" href={href(p.id)} data-cursor="Voir" tabindex="-1" aria-hidden="true">
              {four.map((m, k) => (
                <div class="media" data-reveal style={`--i:${k}`}>
                  <Img image={m.image} alt="" sizes="(max-width: 767px) 50vw, 25vw" vt={k === 3 ? vt : undefined} />
                </div>
              ))}
            </a>
            {caption}
          </article>
        );
      }

      if (i % 2 === 1) {
        const second = firstMedia.find((m) => m.src !== cover.src && m.kind === 'photo') ?? firstMedia.find((m) => m.src !== cover.src);
        return (
          <article class="p p--pair">
            <a class="wrap grid p-pair" href={href(p.id)} data-cursor="Voir" tabindex="-1" aria-hidden="true">
              <div class="media p-pair-a" data-reveal="curtain">
                {cover.pending && <span class="badge-preview">Aperçu · droits à demander</span>}
                <Img image={cover.image} alt="" sizes="(max-width: 767px) 100vw, 58vw" vt={vt} />
              </div>
              {second && (
                <div class="media p-pair-b" data-reveal style="--i:2">
                  <Img image={second.image} alt="" sizes="(max-width: 767px) 60vw, 33vw" />
                </div>
              )}
            </a>
            {caption}
          </article>
        );
      }

      return (
        <article class="p p--full">
          <a class="p-full" href={href(p.id)} data-cursor="Voir" tabindex="-1" aria-hidden="true">
            <div class="media" data-reveal="curtain">
              {cover.pending && <span class="badge-preview">Aperçu · droits à demander</span>}
              <Img image={cover.image} alt="" sizes="100vw" vt={vt} position="center 55%" />
            </div>
          </a>
          {caption}
        </article>
      );
    })}

    <div class="wrap p-more">
      <a class="cta cta--lg" href="/projets">Tous les projets <span class="arrow" aria-hidden="true">→</span></a>
      <a class="meta p-arch" href="/projets/archives">Archives académiques →</a>
    </div>
  </section>

  <!-- 4. EXPERTISES -->
  <section class="section expertises" aria-labelledby="exp-titre">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="display-l" id="exp-titre" data-reveal="lines"><span class="line"><span>Ce que je <span class="serif">fais</span></span></span></h2>
        <span class="meta">(02) Expertises</span>
      </div>
      <div class="exp" data-hover-list>
      <ul class="exp-list" role="list">
        {site.expertises.map((e, i) => (
          <li class="exp-row" data-hover-item={String(i)} data-reveal>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h2 exp-title">{e.title} <span class="serif">{e.accent}</span> {e.titleEnd}</h3>
            <div class="exp-detail">
              <ul role="list">{e.items.map((it) => <li>{it}</li>)}</ul>
              <p class="meta exp-tools">{e.tools.join(' · ')}</p>
            </div>
            {expertiseImages[i] && (
              <div class="exp-mobile-img media">
                <Img image={expertiseImages[i]!} alt="" sizes="100vw" />
              </div>
            )}
          </li>
        ))}
      </ul>
        <div class="exp-preview" data-hover-preview aria-hidden="true">
          {expertiseImages.map((img, i) => img && (
            <div class="exp-preview-img" data-preview-key={String(i)}>
              <Img image={img} alt="" sizes="320px" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 5. CHIFFRE (publié uniquement avec l'accord du restaurant) -->
  {showHighlight && (
    <section class="chiffre" aria-label="Résultat">
      <div class="wrap grid">
        <p class="display chiffre-val" data-reveal>{site.highlight.value}</p>
        <div class="chiffre-txt" data-reveal style="--i:1">
          <p class="lead">{site.highlight.label}</p>
          <p class="meta">{site.highlight.source}{!site.highlight.publishable && <span class="accent"> · Aperçu — accord du restaurant requis</span>}</p>
        </div>
      </div>
    </section>
  )}

  <!-- 6. À PROPOS (COURT) -->
  <section class="section apropos" aria-labelledby="apropos-titre">
    <div class:list={['wrap grid', !portrait && !PREVIEW && 'apropos--noportrait']}>
      {portrait ? (
        <div class="media apropos-img" data-reveal="curtain">
          <Img image={portrait} alt={`Portrait de ${site.name}`} sizes="(max-width: 767px) 100vw, 40vw" />
        </div>
      ) : PREVIEW ? (
        <div class="apropos-img apropos-ph meta" aria-hidden="true">Portrait HD à fournir</div>
      ) : null}
      <div class="apropos-txt">
        <h2 class="meta" id="apropos-titre">(03) À propos</h2>
        <p class="apropos-lead" data-reveal>{site.about.lead}</p>
        <p class="prose apropos-p" data-reveal style="--i:1">{site.about.paragraphs[0]}</p>
        <div class="apropos-links" data-reveal style="--i:2">
          <a class="cta" href="/a-propos">En savoir plus <span class="arrow" aria-hidden="true">→</span></a>
          {cv && <a class="cta" href={cv} download>CV (PDF) <span class="arrow" aria-hidden="true">↓</span></a>}
        </div>
      </div>
    </div>
  </section>

  <!-- 7. PARCOURS -->
  <section class="light section parcours" aria-labelledby="parcours-titre">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="display-l" id="parcours-titre">Parcours</h2>
        <span class="meta">(04)</span>
      </div>
      <ol class="par" role="list">
        {site.parcours.experiences.map((x) => (
          <li class="par-row" data-reveal>
            <span class="meta">{x.period}</span>
            <span class="par-org">{x.org}{x.place && ` — ${x.place}`}</span>
            <span class="par-role">{x.role}</span>
          </li>
        ))}
      </ol>
      <h3 class="meta par-sub">Formation</h3>
      <ol class="par" role="list">
        {site.parcours.formations.map((x) => (
          <li class="par-row" data-reveal>
            <span class="meta">{x.period ?? ''}</span>
            <span class="par-org">{x.org}</span>
            <span class="par-role">{x.place}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 8. MÉTHODE (affichée quand tes étapes réelles sont renseignées) -->
  {showMethode && (
    <section class="section methode" aria-labelledby="methode-titre">
      <div class="wrap">
        <div class="sec-head">
          <h2 class="display-l" id="methode-titre">Méthode</h2>
          <span class="meta">(05){!methodeReady && <span class="accent"> — Aperçu : étapes à rédiger</span>}</span>
        </div>
        <ol class="steps grid" role="list">
          {site.methode.steps.map((s, i) => (
            <li class="step" data-reveal style={`--i:${i}`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h3">{s.title}</h3>
              <p>{s.text ?? '[À compléter]'}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- 9. CONTACT -->
  <ContactSection index={showMethode ? '(06)' : '(05)'} />
</Base>

<style>
  /* Hero */
  .hero { position: relative; height: 100svh; min-height: 560px; max-height: 1100px; overflow: hidden; }
  .hero-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgb(11 11 12 / 0.55) 0%, rgb(11 11 12 / 0) 22%, rgb(11 11 12 / 0) 42%, rgb(11 11 12 / 0.92) 100%);
  }
  .hero-content { position: absolute; inset: auto 0 0 0; padding: 0 var(--margin) clamp(28px, 5vh, 48px); }
  .hero-name { font-size: var(--t-display-xl); }
  .hero-bottom { margin-top: clamp(20px, 4vh, 40px); align-items: end; row-gap: 20px; }
  .hero-tagline { grid-column: 1 / span 5; }
  .hero-tagline .serif { font-size: 1.15em; }
  .hero-meta { grid-column: 7 / span 3; color: var(--gris-300); }
  .hero-actions { grid-column: 10 / span 3; justify-self: end; display: flex; gap: 18px; align-items: center; }
  .hero-scroll { color: var(--gris-300); }
  .hero-pause { color: var(--blanc-50); border: 1px solid var(--gris-600); padding: 8px 12px; }
  @media (max-width: 1023px) {
    .hero-tagline { grid-column: 1 / span 6; }
    .hero-meta { grid-column: 1 / span 5; }
    .hero-actions { grid-column: 6 / span 3; }
  }
  @media (max-width: 767px) {
    .hero-tagline { grid-column: 1 / -1; font-size: 1.0625rem; }
    .hero-meta { grid-column: 1 / span 3; }
    .hero-actions { grid-column: 4 / span 1; }
    .hero-scroll { display: none; }
  }

  /* Manifeste */
  .manifeste { padding-block: clamp(120px, 18vw, 200px); }
  .m-label { grid-column: 1 / span 2; padding-top: 1.2em; }
  .m-text { grid-column: 3 / span 10; font-size: clamp(2.25rem, 5.8vw, 5.25rem); line-height: 1.02; }
  @media (max-width: 1023px) { .m-label, .m-text { grid-column: 1 / -1; } .m-text { margin-top: 20px; } }

  /* Têtes de section */
  .sec-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: clamp(48px, 7vw, 80px); }

  /* Projets */
  .p { margin-bottom: clamp(88px, 11vw, 150px); }
  .p-full .media { height: clamp(380px, 46vw, 680px); }
  .p-cap {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: baseline;
    margin-top: 22px;
  }
  .p-cap .num { grid-column: span 1; }
  .p-title { grid-column: 2 / span 5; font-family: var(--f-display); font-stretch: 110%; font-weight: 500; font-size: clamp(1.75rem, 3.4vw, 3rem); letter-spacing: -0.03em; line-height: 1; }
  .p-link { background: linear-gradient(var(--cognac-500), var(--cognac-500)) 0 100% / 0 1px no-repeat; transition: background-size var(--dur-m) var(--ease-out); }
  .p:hover .p-link, .p-link:focus-visible { background-size: 100% 1px; }
  .p-disc { grid-column: 7 / span 3; }
  .p-role { grid-column: 10 / span 2; }
  .p-year { grid-column: 12; text-align: right; }
  .p .media img { transition: transform 900ms var(--ease-out); }
  @media (hover: hover) { .p:hover .media img { transform: scale(1.03); } }

  .p-pair { align-items: start; }
  .p-pair-a { grid-column: 1 / span 7; aspect-ratio: 7 / 6.5; }
  .p-pair-b { grid-column: 9 / span 4; aspect-ratio: 4 / 5; margin-top: 30%; }
  .p-trio { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter); }
  .p-trio .media { aspect-ratio: 1 / 1; }
  .p-four { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--gutter); align-items: start; }
  .p-four .media { aspect-ratio: 9 / 16; }
  .p-four .media:nth-child(even) { margin-top: 12%; }
  .p--empty { margin-bottom: 0; }
  .p--empty + .p:not(.p--empty) { margin-top: clamp(88px, 11vw, 150px); }
  .p--empty + .p--empty .p-empty { border-top: 0; }
  .p-empty { display: grid; gap: 18px; padding-block: 64px; border-block: 1px solid var(--gris-700); }

  .p-more { display: flex; justify-content: space-between; align-items: center; gap: 24px; }
  .p-arch { color: var(--gris-300); }
  .p-arch:hover { color: var(--cognac-300); }

  @media (max-width: 1023px) {
    .p-title { grid-column: 2 / span 11; }
    .p-disc { grid-column: 2 / span 7; margin-top: 10px; }
    .p-role { grid-column: 9 / span 3; margin-top: 10px; }
  }
  @media (max-width: 767px) {
    .p-cap { grid-template-columns: 1fr auto; row-gap: 6px; }
    .p-cap .num { grid-column: 2; grid-row: 1; justify-self: end; }
    .p-title { grid-column: 1; grid-row: 1; }
    .p-disc { grid-column: 1 / -1; margin-top: 0; }
    .p-role { display: none; }
    .p-year { grid-column: 1 / -1; text-align: left; }
    .p-full .media { height: auto; aspect-ratio: 4 / 5; }
    .p-pair-a { grid-column: 1 / -1; aspect-ratio: 4 / 5; }
    .p-pair-b { display: none; }
    .p-trio { grid-template-columns: 1fr; }
    .p-trio .media:not(:first-child) { display: none; }
    .p-trio .media { aspect-ratio: 4 / 5; }
    .p-four { grid-template-columns: repeat(2, 1fr); }
    .p-four .media:nth-child(n + 3) { display: none; }
    .p-more { flex-direction: column; align-items: flex-start; }
  }

  /* Expertises */
  .exp { position: relative; }
  .exp-row {
    display: grid;
    grid-template-columns: 80px 1fr minmax(260px, 420px);
    gap: 24px;
    align-items: baseline;
    padding-block: 34px;
    border-top: 1px solid var(--gris-700);
  }
  .exp-row:last-of-type { border-bottom: 1px solid var(--gris-700); }
  .exp-title { font-size: clamp(1.75rem, 3.9vw, 3.5rem); }
  .exp-detail li { font-size: 0.9375rem; color: var(--gris-300); padding-block: 3px; }
  .exp-tools { margin-top: 10px; }
  .exp-mobile-img { display: none; }
  .exp-preview {
    position: absolute;
    left: 0; top: 0;
    width: 260px; height: 320px;
    margin: -160px 0 0 -130px;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-m) var(--ease-out);
    z-index: 2;
  }
  .exp-preview.is-on { opacity: 1; }
  .exp-preview-img { position: absolute; inset: 0; opacity: 0; transition: opacity var(--dur-s) var(--ease-out); }
  .exp-preview-img.is-on { opacity: 1; }
  .exp-preview-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (hover: none), (max-width: 1023px) { .exp-preview { display: none; } }
  @media (max-width: 1023px) {
    .exp-row { grid-template-columns: 48px 1fr; }
    .exp-detail { grid-column: 2; }
  }
  @media (max-width: 767px) {
    .exp-row { grid-template-columns: 1fr; gap: 12px; }
    .exp-detail { grid-column: 1; }
    .exp-mobile-img { display: block; aspect-ratio: 16 / 10; margin-top: 12px; }
  }

  /* Chiffre */
  .chiffre { padding: 0 0 var(--section); }
  .chiffre-val { grid-column: 1 / span 7; font-size: clamp(5rem, 18vw, 16rem); font-stretch: 108%; }
  .chiffre-txt { grid-column: 8 / span 5; align-self: end; padding-bottom: 2%; display: grid; gap: 14px; }
  @media (max-width: 1023px) { .chiffre-val, .chiffre-txt { grid-column: 1 / -1; } .chiffre-txt { margin-top: 20px; } }

  /* À propos */
  .apropos .grid { align-items: end; }
  .apropos-img { grid-column: 1 / span 5; aspect-ratio: 4 / 5; }
  .apropos-ph { display: grid; place-items: center; background: repeating-linear-gradient(135deg, var(--noir-800) 0 10px, var(--noir-900) 10px 20px); }
  .apropos-txt { grid-column: 7 / span 6; }
  .apropos--noportrait .apropos-txt { grid-column: 3 / span 8; }
  .apropos-lead { margin-top: 28px; font-size: clamp(1.5rem, 2.3vw, 2rem); line-height: 1.3; letter-spacing: -0.01em; }
  .apropos-p { margin-top: 22px; }
  .apropos-links { display: flex; gap: 36px; margin-top: 36px; flex-wrap: wrap; }
  @media (max-width: 1023px) {
    .apropos-img, .apropos-txt, .apropos--noportrait .apropos-txt { grid-column: 1 / -1; }
    .apropos-txt { margin-top: 40px; }
    .apropos-img { max-width: 520px; }
  }

  /* Parcours */
  .par-row { display: grid; grid-template-columns: 200px 1fr 1fr; gap: 24px; padding-block: 20px; border-top: 1px solid var(--gris-100); }
  .par:last-of-type .par-row:last-child { border-bottom: 1px solid var(--gris-100); }
  .par-org { font-weight: 500; }
  .par-sub { margin-top: 48px; margin-bottom: 12px; }
  @media (max-width: 767px) {
    .par-row { grid-template-columns: 1fr; gap: 4px; }
    .par-role { color: var(--gris-600); }
  }

  /* Méthode */
  .steps { row-gap: 40px; }
  .step { grid-column: span 3; border-top: 1px solid var(--gris-700); padding-top: 22px; }
  .step .h3 { margin-top: 36px; }
  .step p { margin-top: 10px; color: var(--gris-400); font-size: 0.9375rem; }
  @media (max-width: 1023px) { .step { grid-column: span 4; } }
  @media (max-width: 767px) { .step { grid-column: 1 / -1; } }
</style>
